# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled endpoint recommended for serverless)
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ─── Sentry ───────────────────────────────────────────────────────────────────
# Sentry DSN for error tracking
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Auth token for source map uploads (generate at sentry.io/settings/auth-tokens)
SENTRY_AUTH_TOKEN=""

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────
# Secret for signing session cookies (generate with: openssl rand -base64 32)
AUTH_SECRET=""
# Google OAuth credentials (from Google Cloud Console)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Gmail OAuth (Epic 6) ─────────────────────────────────────────────────────
# AES-256-GCM key for encrypting Gmail refresh tokens (32-byte hex string)
# Generate with: openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=""

# ─── Object storage — Vercel Blob (private store) ─────────────────────────────
# CV files and per-application snapshots are stored in Vercel Blob, configured
# as a *private* store. See project-context.md → "Object storage — Vercel Blob"
# for the binding rules (private access, same-origin proxy for delivery, etc.).
#
# Vercel auto-injects this token on Production / Preview / Development when a
# Blob store is connected to the project. Pull it locally with:
#   vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=""

# ─── Stripe (Story 5.2) ───────────────────────────────────────────────────────
# Secret API key — use sk_test_… in dev, sk_live_… in prod.
STRIPE_SECRET_KEY=""
# Webhook signing secret. From Stripe Dashboard → Developers → Webhooks → your
# endpoint → "Signing secret". In local dev, get this from `stripe listen`.
STRIPE_WEBHOOK_SECRET=""
# Recurring Price id for the Pro plan (create the Price in Stripe → Products).
STRIPE_PRO_PRICE_ID=""

# ─── App URL ──────────────────────────────────────────────────────────────────
# Public base URL used to build Stripe Checkout success/cancel redirect URLs.
# Locally: http://localhost:3000 — in production set to your deployed origin.
# (Vercel auto-sets VERCEL_URL as a fallback if APP_URL is unset.)
APP_URL="http://localhost:3000"
